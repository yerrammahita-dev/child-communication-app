<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Little Ways — Read, Create, Communicate</title>
<style>
:root{--ink:#24333b;--muted:#68777c;--paper:#fbfaf7;--white:#fff;--line:#e4e8e5;--green:#376c5c;--mint:#e8f2ed;--coral:#f4e3dc;--blue:#e5eef3;--yellow:#f5efd9;--shadow:0 8px 26px #263b3210}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,a:focus-visible{outline:3px solid #e4a44b;outline-offset:3px}.shell{max-width:1180px;margin:auto;padding:20px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px}.brand{font-size:22px;font-weight:800;letter-spacing:-.5px}.brand span{color:var(--green)}.nav{display:flex;gap:7px;flex-wrap:wrap}.nav button,.btn{border:1px solid var(--line);background:white;color:var(--ink);border-radius:12px;padding:10px 14px;font-weight:650}.nav button.active,.btn.primary{background:var(--green);color:white;border-color:var(--green)}.nav button:hover,.btn:hover{transform:translateY(-1px);box-shadow:var(--shadow)}main{min-height:65vh}.hero{position:relative;overflow:hidden;border-radius:24px;background:linear-gradient(135deg,#fff1b9,#ffe1ef 52%,#dceeff);padding:clamp(28px,6vw,68px);margin-bottom:24px}.hero h1{font-size:clamp(34px,6vw,62px);line-height:1.04;max-width:650px;margin:0 0 16px;letter-spacing:-2px}.hero p{font-size:19px;color:#52645d;max-width:590px}.squiggles{position:absolute;inset:0;pointer-events:none;transition:opacity .5s}.squiggles.off{opacity:0!important}.squiggles svg{position:absolute;width:100%;height:100%;inset:0}.squiggles path{fill:none;stroke-width:22;opacity:.28;stroke-linecap:round;filter:blur(1px);animation:drift 9s ease-in-out infinite alternate}.squiggles path:nth-child(2){animation-delay:-3s}.squiggles path:nth-child(3){animation-delay:-6s}@keyframes drift{0%{transform:translate(0,0)}100%{transform:translate(25px,-18px)}}.hero-content{position:relative;z-index:1}.hero .btn{margin-top:8px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}.card{background:white;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:var(--shadow)}.home-card{min-height:150px;display:flex;flex-direction:column;justify-content:space-between}.home-card .icon{font-size:28px}.home-card h2{font-size:20px;margin:8px 0 2px}.home-card p,.muted{color:var(--muted);margin:0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:20px 0}.section-head h1{margin:0;font-size:34px;letter-spacing:-1px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.input,select,textarea{border:1px solid #d9e0dc;border-radius:10px;padding:11px 12px;background:#fff;color:var(--ink)}.input{min-width:190px}

/* 3D Bulging Hover Effect & Uniform Image Cropping */
.book-card{transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.3s ease;transform-origin:center center;will-change:transform;display:flex;flex-direction:column;justify-content:space-between}
.book-card:hover,.book-card:focus-within{transform:scale(1.06) translateY(-8px);box-shadow:0 22px 36px rgba(38,59,50,0.2);z-index:10}
.book-cover-img{width:100%;height:180px;object-fit:cover;object-position:center;border-radius:12px;margin-bottom:12px;box-shadow:0 4px 10px rgba(0,0,0,0.1);background:#e8f2ed}

.reader{max-width:760px;margin:20px auto;background:white;border:1px solid var(--line);border-radius:20px;padding:clamp(24px,6vw,55px);text-align:center}.reader .page-text{font-size:clamp(24px,4vw,36px);line-height:1.45;min-height:180px;display:grid;place-items:center}.reader-controls{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.board-layout{display:grid;grid-template-columns:220px 1fr;gap:16px}.categories{display:grid;gap:8px;align-content:start}.categories button{text-align:left}.word-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:10px}.word{min-height:76px;background:#f3f6f3;border:1px solid var(--line);border-radius:14px;font-size:20px;font-weight:700;color:var(--ink)}.word:hover{background:var(--mint)}.sentence{min-height:70px;font-size:24px;padding:14px;background:#f7f8f5;border:1px dashed #cbd6cf;border-radius:14px;margin:12px 0}.canvas-wrap{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;touch-action:none}.canvas-wrap canvas{display:block;width:100%;height:min(55vh,520px);touch-action:none;cursor:crosshair}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:12px 0}.colors{display:flex;gap:6px;flex-wrap:wrap}.color{width:28px;height:28px;border:2px solid white;box-shadow:0 0 0 1px #aab5af;border-radius:50%;padding:0}.color.selected{box-shadow:0 0 0 3px var(--green)}.coloring-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.color-page{background:white;border:1px solid var(--line);border-radius:16px;padding:14px;transition:transform 0.2s}.color-page.expanded{position:fixed;inset:20px;z-index:100;max-width:900px;margin:auto;height:calc(100vh - 40px);overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,0.3)}.color-page svg{width:100%;height:220px;background:#faf9f5;border-radius:12px}.color-page svg [data-color]{cursor:pointer;stroke:#53615c;stroke-width:2;transition:fill 0.2s}.color-page svg [data-color]:hover{stroke:#111;stroke-width:4}.notice{background:#fff1bd;border-radius:12px;padding:12px 14px;color:#665a32}.list{display:grid;gap:9px}.list-item{display:flex;justify-content:space-between;align-items:center;gap:10px;background:white;border:1px solid var(--line);border-radius:12px;padding:12px}.small{font-size:14px}.footer{padding:24px 0;color:var(--muted);font-size:14px}.empty{padding:28px;text-align:center;color:var(--muted)}.hidden{display:none!important}
@media(max-width:700px){.shell{padding:13px}.top{align-items:flex-start;flex-direction:column}.nav{display:grid;grid-template-columns:repeat(3,1fr);width:100%}.nav button{padding:9px 5px;font-size:14px}.board-layout{grid-template-columns:1fr}.categories{display:flex;overflow:auto}.categories button{white-space:nowrap}.hero{padding:30px 22px}.section-head h1{font-size:29px}}
</style>
</head>
<body>
<div class="shell">
<header class="top">
  <div class="brand">little <span>ways</span></div>
  <nav class="nav" aria-label="Main navigation" id="nav"></nav>
</header>
<main id="app"></main>
<footer class="footer">A welcoming space to read, create, and communicate. Saved information stays in this browser.</footer>
</div>
<script>
const STORE={vocab:"lw-vocab-v1",sentences:"lw-sentences-v1",history:"lw-history-v1",drawings:"lw-drawings-v1",colors:"lw-color-pages-v1"};
const initialVocab={
 People:["I","you","mom","dad","teacher","friend","grandma","grandpa","sister","brother","they","we"],
 Feelings:["happy","sad","tired","excited","calm","worried","silly","angry","scared","proud"],
 Actions:["want","like","need","go","stop","play","read","draw","eat","drink","help","look","make","rest"],
 Places:["home","school","park","outside","bedroom","bathroom","kitchen","library","store"],
 Objects:["book","ball","juice","toy","blanket","pencil","paper","tablet","music","snack"],
 Helpers:["please","thank you","help","yes","no","more","all done","again","my turn","your turn"],
 Needs:["break","water","food","toilet","quiet","hug","medicine","different","wait"],
 Food:["apple","banana","bread","pasta","rice","milk","water","cracker","cheese","strawberry"],
 Questions:["what","where","who","when","why","how","can I","do you"],
 Social:["hello","goodbye","excuse me","I love you","good morning","good night"],
 Sensory:["too loud","too bright","soft","cold","hot","itchy","comfortable","quiet"]
};
let vocab=load(STORE.vocab,initialVocab),saved=load(STORE.sentences,[]),history=load(STORE.history,[]),drawings=load(STORE.drawings,[]);
function load(k,fallback){try{return JSON.parse(localStorage.getItem(k))??fallback}catch{return fallback}}
function persist(){localStorage.setItem(STORE.vocab,JSON.stringify(vocab));localStorage.setItem(STORE.sentences,JSON.stringify(saved));localStorage.setItem(STORE.history,JSON.stringify(history));localStorage.setItem(STORE.drawings,JSON.stringify(drawings))}

const books=[
  {title:"The Three Little Pigs",author:"Classic Tale",image:"https://images.unsplash.com/photo-1518780664697-55e3ad937233?w=400&auto=format&fit=crop&q=60",summary:"Three little pigs build houses and face a hungry wolf.",pages:[
    "Three little pigs left home to build houses of their own.",
    "The first pig built quickly with straw.",
    "The second pig made a house from sticks.",
    "The third pig carefully built with bricks.",
    "A hungry wolf came to the straw house.",
    "The wolf blew it down, and the first pig escaped.",
    "The wolf blew down the stick house too.",
    "Both pigs ran to the brick house.",
    "The wolf could not blow it down and finally left.",
    "The pigs learned that careful work and teamwork can keep them safe."
  ]},
  {title:"Little Red Riding Hood",author:"Classic Tale",image:"https://images.unsplash.com/photo-1448375240586-882707db888b?w=400&auto=format&fit=crop&q=60",summary:"A journey through the woods to visit grandmother.",pages:[
    "Little Red Riding Hood packed a basket for Grandma.",
    "Her mother reminded her to stay on the forest path.",
    "A wolf asked where she was going.",
    "Little Red said she was visiting her grandmother.",
    "The wolf took a shortcut to Grandma’s cottage.",
    "He hid Grandma safely and dressed in her clothes.",
    "Little Red arrived and noticed something seemed unusual.",
    "She asked about the wolf’s big ears, eyes, and teeth.",
    "The wolf jumped up, and Little Red ran outside.",
    "A nearby woodcutter heard her call and helped Grandma.",
    "Little Red hugged Grandma and promised to be more careful."
  ]},
  {title:"Goldilocks and the Three Bears",author:"Classic Tale",image:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&auto=format&fit=crop&q=60",summary:"An unexpected visitor in a bear family's cottage.",pages:[
    "Three bears made porridge and went for a walk while it cooled.",
    "Goldilocks found their cottage in the woods.",
    "She knocked, but nobody answered.",
    "She went inside without asking permission.",
    "The biggest bowl of porridge was too hot.",
    "The middle bowl was too cold.",
    "The smallest bowl was just right, so she ate it.",
    "Goldilocks tried the bears’ chairs.",
    "The smallest chair broke when she sat down.",
    "Upstairs, she fell asleep in the little bear’s bed.",
    "The bears returned and found Goldilocks.",
    "She hurried home, realizing she should respect other people’s homes."
  ]},
  {title:"Pinocchio",author:"Classic Tale",image:"https://images.unsplash.com/photo-1512820790803-83ca734da794?w=400&auto=format&fit=crop&q=60",summary:"A wooden puppet learns the value of honesty.",pages:[
    "A woodcarver made a puppet from a piece of wood.",
    "He named him Pinocchio and wished he could become a real boy.",
    "Pinocchio came to life and wanted to explore.",
    "The woodcarver gave him a book for school.",
    "On the way, Pinocchio met strangers who promised easy fun.",
    "He followed them instead of going to class.",
    "Their promises led him into trouble.",
    "When Pinocchio lied, his nose grew longer.",
    "A kind fairy encouraged him to tell the truth.",
    "Later, Pinocchio learned the woodcarver needed help.",
    "He bravely set out to find him.",
    "Pinocchio helped the woodcarver return home safely.",
    "His honesty and courage brought him closer to becoming a real boy."
  ]},
  {title:"Peter Pan",author:"Classic Tale",image:"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=400&auto=format&fit=crop&q=60",summary:"Flying away to the magical island of Neverland.",pages:[
    "Wendy and her brothers loved stories about Peter Pan.",
    "One night, Peter visited their room with Tinker Bell.",
    "He taught them to fly by thinking happy thoughts.",
    "Together, they soared to Neverland.",
    "They met the Lost Boys and explored the island.",
    "The children heard that Captain Hook was nearby.",
    "Wendy told the Lost Boys stories about home.",
    "Hook planned to capture Peter’s friends.",
    "Peter and the Lost Boys worked together to foil his plan.",
    "The children escaped and stayed close to one another.",
    "Wendy began to miss her family.",
    "Her brothers felt homesick too.",
    "Peter guided them through the night sky.",
    "Their family welcomed them home, and they remembered Neverland fondly."
  ]},
  {title:"The Ugly Duckling",author:"Hans Christian Andersen",image:"https://images.unsplash.com/photo-1437622368342-7a3d73a34c8f?w=400&auto=format&fit=crop&q=60",summary:"A young bird discovers his true beauty.",pages:[
    "A mother duck watched her eggs hatch.",
    "One duckling looked different from the others.",
    "The farm animals teased him.",
    "Feeling lonely, he wandered away.",
    "He searched fields and ponds for a place to belong.",
    "The seasons changed, and winter came.",
    "The duckling struggled to find shelter.",
    "Spring returned, bringing warmth to the pond.",
    "The duckling saw graceful swans swimming nearby.",
    "He approached them shyly.",
    "Looking into the water, he saw a swan looking back.",
    "He had grown into a beautiful swan.",
    "The other swans welcomed him.",
    "He felt at home at last.",
    "He learned that being different did not make him less worthy of kindness."
  ]}
  /* Added sample base; truncated listing dynamically expandable or populated via search */
];

let page="Home",activeBook=null,bookPage=0,sentence[],category=Object.keys(vocab)[0];
const pages=["Home","Books","Draw","Color by Number","Sentence","Vocabulary","Settings"];
function go(p){page=p;render()}
function renderNav(){document.querySelector("#nav").innerHTML=pages.map(p=>`<button class="${page===p?"active":""}" data-page="${p}">${p==="Color by Number"?"Color":p}</button>`).join("");document.querySelectorAll("[data-page]").forEach(b=>b.onclick=()=>go(b.dataset.page))}
function render(){renderNav();const root=document.querySelector("#app");if(page==="Home")root.innerHTML=home();if(page==="Books")root.innerHTML=library();if(page==="Draw")root.innerHTML=drawing();if(page==="Color by Number")root.innerHTML=coloring();if(page==="Sentence")root.innerHTML=sentenceBoard();if(page==="Vocabulary")root.innerHTML=vocabularyPage();if(page==="Settings")root.innerHTML=settings();bind()}

function home(){return `<section class="hero"><div class="squiggles" id="squiggles"><svg viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true"><path stroke="#ee78ad" d="M-20 80 C180 10 180 180 360 100 S600 10 800 100 950 120 1030 50"/><path stroke="#609de0" d="M-20 280 C160 190 250 360 420 250 S650 170 780 290 920 330 1030 230"/><path stroke="#e9bd42" d="M100 410 C160 250 320 300 400 190 S650 100 700 210 850 260 900 130"/></svg></div><div class="hero-content"><p class="muted">A welcoming space for every way of communicating</p><h1>Read, make, and share—your way.</h1><p>Explore stories, create art, and build messages at your own pace.</p><button class="btn primary" data-go="Sentence">Make a sentence</button> <button class="btn" data-go="Books">Explore books</button><p class="small">Tap the heading to hide the moving lines.</p></div></section><div class="grid">${[["📚","Read a Book","Browse stories and children's literature.","Books"],["✏️","Draw","Make a picture with colors and stencils.","Draw"],["▦","Color by Number","Fill advanced picture regions with color.","Color by Number"],["💬","Make a Sentence","Choose words to build a message.","Sentence"],["⚙️","My Vocabulary","Personalize words and categories.","Vocabulary"]].map(x=>`<button class="card home-card" data-go="${x[3]}" style="text-align:left;color:inherit"><span class="icon">${x[0]}</span><span><h2>${x[1]}</h2><p>${x[2]}</p></span></button>`).join("")}</div>`}

function library(){if(activeBook!==null)return reader();return `<div class="section-head"><div><p class="muted">Interactive children's library</p><h1>Book shelf</h1></div><input class="input" id="bookSearch" placeholder="Search stories…" aria-label="Search stories"></div><div class="grid" id="bookGrid">${books.map((b,i)=>`<article class="card book-card"><img src="${b.image}" alt="${escapeHtml(b.title)} cover" class="book-cover-img" loading="lazy"><div><h2>${escapeHtml(b.title)}</h2><p class="muted small" style="margin-bottom:12px">${escapeHtml(b.summary)}</p></div><button class="btn primary read-btn" data-read-id="${i}">Read</button></article>`).join("")}</div><section class="section-head"><div><p class="muted">Search up to 500 public book listings</p><h2>Open Library Catalog</h2></div></section><form id="catalogSearch" class="row"><input class="input" name="q" placeholder="Type a subject or topic (e.g. fairy tales, animals, magic)..." value="children stories" required><button class="btn primary">Search Books</button></form><p class="small muted" id="catalogStatus">Click 'Search Books' to browse open titles.</p><div class="grid" id="catalogGrid"></div>`}

function reader(){let b=books[activeBook];return `<button class="btn" id="backToShelf">← Back to shelf</button><article class="reader"><p class="muted">${b.title}</p><div class="page-text">${b.pages[bookPage]}</div><p class="muted">Page ${bookPage+1} of ${b.pages.length}</p><div class="reader-controls"><button class="btn" id="prevPage" ${bookPage===0?"disabled":""}>Previous</button><button class="btn" id="readAloud">Read aloud</button><button class="btn primary" id="nextPage" ${bookPage===b.pages.length-1?"disabled":""}>Next</button></div></article>`}

function drawing(){return `<div class="section-head"><div><p class="muted">A creative space</p><h1>Drawing studio</h1></div></div><div class="toolbar"><label>Brush <select id="brush"><option>Pen</option><option>Marker</option><option>Pencil</option><option>Soft brush</option><option>Eraser</option></select></label><label>Size <input id="size" type="range" min="2" max="36" value="7"></label><label>Shape / Stencil <select id="shape"><option value="free">Free draw</option><option value="line">Ruler line</option><option value="circle">Circle stencil</option><option value="square">Square stencil</option><option value="triangle">Triangle stencil</option><option value="star">Star stencil</option><option value="heart">Heart stencil</option></select></label><button class="btn" id="undo">Undo</button><button class="btn" id="clearCanvas">Clear</button><button class="btn primary" id="saveDrawing">Save drawing</button></div><div class="toolbar"><span>Color</span><div class="colors" id="palette"></div></div><div class="canvas-wrap"><canvas id="canvas" aria-label="Drawing canvas"></canvas></div><h2>Saved drawings</h2><div class="grid">${drawings.map((d,i)=>`<div class="card"><img alt="Saved drawing ${i+1}" src="${d}" style="width:100%;border-radius:10px"><button class="btn" data-delete-drawing="${i}">Remove</button></div>`).join("")||`<p class="muted">Your saved drawings will appear here.</p>`}</div>`}

function sentenceBoard(){const cats=Object.keys(vocab);if(!vocab[category])category=cats[0];return `<div class="section-head"><div><p class="muted">Choose words to share a message</p><h1>Sentence board</h1></div></div><section class="card"><div class="muted small">Tap a word below to add it. Tap a sentence word to remove it.</div><div class="sentence" id="sentence">${sentence.map((w,i)=>`<button class="btn" data-remove-word="${i}">${escapeHtml(w)} ×</button>`).join(" ")||`<span class="muted">Your words will appear here.</span>`}</div><div class="row"><button class="btn" id="clearSentence">Clear sentence</button><button class="btn primary" id="speak">Speak</button><button class="btn" id="saveSentence">Save sentence</button></div></section><div class="board-layout" style="margin-top:16px"><aside class="categories">${cats.map(c=>`<button class="btn ${category===c?"primary":""}" data-category="${escapeHtml(c)}">${escapeHtml(c)}</button>`).join("")}</aside><section class="card"><div class="word-grid">${(vocab[category]||[]).map(w=>`<button class="word" data-word="${escapeHtml(w)}">${escapeHtml(w)}</button>`).join("")||`<p class="empty">No words in this category yet.</p>`}</div></section></div>`}

function vocabularyPage(){return `<div class="section-head"><div><p class="muted">Personalize your words</p><h1>My vocabulary</h1></div></div><p class="notice">Add your own words and categories. Changes appear on the sentence board and stay in this browser.</p><section class="card"><h2>Add a word</h2><form id="addWord" class="row"><input class="input" name="word" required placeholder="Word or short phrase"><select name="category">${Object.keys(vocab).map(c=>`<option>${escapeHtml(c)}</option>`).join("")}</select><input class="input" name="newCategory" placeholder="Or create a category"><button class="btn primary">Add word</button></form><hr style="border:0;border-top:1px solid var(--line);margin:20px 0"><h2>Add a category</h2><form id="addCategory" class="row"><input class="input" name="category" required placeholder="Category name"><button class="btn">Add category</button></form></section><div class="section-head"><h2>Words</h2><input id="vocabSearch" class="input" placeholder="Find a word…"></div><div id="vocabList" class="list">${vocabList()}</div>`}
function vocabList(q=""){return Object.entries(vocab).flatMap(([c,words])=>words.map((w,i)=>({c,w,i}))).filter(x=>(x.w+" "+x.c).toLowerCase().includes(q.toLowerCase())).map(x=>`<div class="list-item"><span><b>${escapeHtml(x.w)}</b> <span class="muted small">· ${escapeHtml(x.c)}</span></span><span class="row"><button class="btn small" data-edit-word="${encodeURIComponent(x.c)}|${x.i}">Edit</button><button class="btn small" data-delete-word="${encodeURIComponent(x.c)}|${x.i}">Remove</button></span></div>`).join("")||`<p class="empty">No matching words.</p>`}

function settings(){return `<div class="section-head"><div><p class="muted">Your browser, your choices</p><h1>Settings</h1></div></div><section class="card"><h2>Local data</h2><p>Vocabulary, drawings, saved sentences, and history are stored in this browser on this device.</p><button class="btn" id="exportData">Download my data</button> <button class="btn" id="resetData">Reset app data</button></section><section class="card" style="margin-top:14px"><h2>About</h2><p class="muted">Stories and coloring galleries designed for interactive learning.</p><label><input type="checkbox" id="reduceMotion"> Hide home-page motion</label></section>`}

function coloring(){
let items=[
["Detailed","Coral Reef Discovery",["#ff6b6b","#4ecdc4","#ffe66d","#1a535c","#f7fff7","#ff9f1c","#2ab7ca","#e63946","#a8dede","#f4a261"],["<path data-color='1' d='M20 100 Q60 20 120 100 Q60 180 20 100Z' fill='white'/><path data-color='2' d='M120 100 L180 50 L180 150Z' fill='white'/><circle data-color='3' cx='60' cy='85' r='12' fill='white'/><path data-color='4' d='M80 120 Q120 150 160 120 L150 160Z' fill='white'/><path data-color='5' d='M10 170 Q40 140 70 170 T130 170' fill='white'/><path data-color='6' d='M140 30 Q170 10 190 40Z' fill='white'/><circle data-color='7' cx='150' cy='70' r='15' fill='white'/><rect data-color='8' x='30' y='20' width='30' height='30' fill='white'/><path data-color='9' d='M160 140 L190 170 L140 180Z' fill='white'/><circle data-color='10' cx='110' cy='40' r='8' fill='white'/>"]],
["Detailed","Enchanted Forest",["#2a9d8f","#e9c46a","#f4a261","#e76f51","#264653","#8ab17d","#babb74","#e7c6ff","#c8b6ff","#ffd6ff"],["<path data-color='1' d='M100 20 L140 90 L60 90Z' fill='white'/><path data-color='2' d='M100 60 L150 130 L50 130Z' fill='white'/><rect data-color='3' x='85' y='130' width='30' height='50' fill='white'/><circle data-color='4' cx='40' cy='50' r='20' fill='white'/><circle data-color='5' cx='160' cy='50' r='20' fill='white'/><path data-color='6' d='M20 150 Q50 120 80 150Z' fill='white'/><path data-color='7' d='M120 150 Q150 120 180 150Z' fill='white'/><circle data-color='8' cx='100' cy='15' r='6' fill='white'/><path data-color='9' d='M10 180 L190 180 L190 190 L10 190Z' fill='white'/><circle data-color='10' cx='160' cy='120' r='10' fill='white'/>"]],
["Detailed","Magical Castle",["#d77d62","#e8c77b","#6b9b73","#8fb5c4","#8a6f5a","#ffb703","#fb8500","#219ebc","#126782","#8ecae6"],["<rect data-color='1' x='50' y='80' width='100' height='90' fill='white'/><polygon data-color='2' points='50,80 100,30 150,80' fill='white'/><rect data-color='3' x='85' y='120' width='30' height='50' fill='white'/><circle data-color='4' cx='100' cy='60' r='12' fill='white'/><rect data-color='5' x='20' y='100' width='25' height='70' fill='white'/><polygon data-color='6' points='20,100 32,60 45,100' fill='white'/><rect data-color='7' x='155' y='100' width='25' height='70' fill='white'/><polygon data-color='8' points='155,100 167,60 180,100' fill='white'/><circle data-color='9' cx='32' cy='80' r='6' fill='white'/><circle data-color='10' cx='167' cy='80' r='6' fill='white'/>"]]
];
return `<div class="section-head"><div><p class="muted">Tap a number, then a matching region. Click expand to enlarge.</p><h1>Coloring Gallery</h1></div></div><p class="notice small">Advanced coloring with 10 color regions per picture.</p><div class="coloring-grid">${items.map((it,i)=>`<article class="color-page" data-pic-id="${i}"><h2>${it[1]}</h2><p class="muted small">${it[0]} · 10 Colors</p><svg viewBox="0 0 200 190" role="img">${it[3].join("")}</svg><div class="row" style="margin-top:10px">${it[2].map((col,n)=>`<button class="btn color-number" data-pic="${i}" data-num="${n+1}" style="border-color:${col};padding:4px 8px;font-size:12px">${n+1} <span style="display:inline-block;width:12px;height:12px;background:${col};border-radius:50%;vertical-align:middle"></span></button>`).join("")}</div><p class="small muted" id="progress${i}" style="margin-top:6px">Select a number to start coloring.</p><div class="row" style="margin-top:8px"><button class="btn small toggle-expand">Expand view</button><button class="btn small" data-reset-pic="${i}">Reset</button></div></article>`).join("")}</div>`;
}

function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}

function bind(){
document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>go(b.dataset.go));
const heading=document.querySelector(".hero h1");if(heading)heading.onclick=()=>document.querySelector("#squiggles")?.classList.toggle("off");
if(page==="Books"){
if(activeBook!==null){
document.querySelector("#backToShelf").onclick=()=>{activeBook=null;bookPage=0;render()};
document.querySelector("#prevPage").onclick=()=>{bookPage--;render()};
document.querySelector("#nextPage").onclick=()=>{bookPage++;render()};
document.querySelector("#readAloud").onclick=()=>{if("speechSynthesis"in window){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(books[activeBook].pages[bookPage]))}else alert("Device speech is unavailable.")}
}
else{
document.querySelectorAll(".read-btn").forEach(b=>b.onclick=(e)=>{e.stopPropagation();activeBook=+b.dataset.readId;bookPage=0;render()});
document.querySelector("#bookSearch").oninput=e=>{let q=e.target.value.toLowerCase();document.querySelectorAll("#bookGrid .book-card").forEach((
